+def test_roi_only_log_equals_full_log_restricted_to_subset(project_n, tmp_path):
+    """--roi-only processes only the subset; its observations equal the full-run log on the subset."""
+    n = PlyPointSource(project_n["root"] / "bridge_3dpc_point_cloud.ply").n_points
+    subset = np.sort(np.random.default_rng(3).choice(n, n // 5, replace=False)).astype(np.int64)
+    np.save(tmp_path / "roi.npy", subset)
+
+    def run(out, *extra):
+        assert main(["--project-root", str(project_n["root"]), "--output-dir", str(tmp_path / out),
+                     "--start-image", "0", "--end-image", "5", "--occlusion", "none", "--point-frame", "transformed", "--observation-log",
+                     "--observation-subset", str(tmp_path / "roi.npy"), *extra]) == 0
+
+    run("full")
+    run("roi", "--roi-only")
+    a, b = load_observations(tmp_path / "full"), load_observations(tmp_path / "roi")
+    assert len(a) > 0 and np.isin(b["source_index"], subset).all()
+    np.testing.assert_array_equal(a, b)
+    assert PlyPointSource(tmp_path / "roi" / "outputs" / "fused_points.ply").n_points == len(subset)
+    with pytest.raises(RuntimeError, match="mutually exclusive"):
+        run("bad", "--roi-only", "--max-points", "100")
