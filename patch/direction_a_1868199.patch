+    keep = ~((u > 150) & (u < 250) & (v > 100) & (v < 200))
+    grid = footprint_mask(u[keep], v[keep], 400, 300, cell_px=4, spacing_px=2.0)
+    rois, holes = mask_to_polygons(grid, 4, 400, 300, min_area_frac=0.001)
+    assert len(rois) == 1 and len(holes) == 1
