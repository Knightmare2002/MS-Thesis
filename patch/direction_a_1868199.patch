diff --git a/damage3d/fusion_benchmark.py b/damage3d/fusion_benchmark.py
new file mode 100644
index 0000000..60fc5b7
--- /dev/null
+++ b/damage3d/fusion_benchmark.py
@@ -0,0 +1,154 @@
+"""Offline baselines/ablations on identical visibility observations; nested camera subsets."""
+from __future__ import annotations
+
+import argparse
+from dataclasses import replace
+from pathlib import Path
+import numpy as np
+
+from .classes import DAMAGE_CLASSES, NUM_CLASSES
+from .detectability import FusionModel
+from .experiment_data import (read_json, write_json, regions, provenance, match_rows,
+                              validate_fit_provenance, validate_detector)
+from .observations import iter_observations, probs_of
+from .run_state import sha256_file
+
+METHODS = ("mean", "max", "angle_range", "distance_range", "distance_weighted",
+           "naive_bayes", "tempered_bayes", "censored_untempered", "censored",
+           "pi_weighted_mean", "pi_weighted_llr")
+
+
+def camera_subset(cameras, fraction, seed):
+    """Same permutation across fractions: global camera subset, not per-point sampling."""
+    if not 0 < fraction <= 1:
+        raise ValueError("fraction must be in (0,1].")
+    cams = np.sort(np.unique(cameras))
+    return np.sort(np.random.default_rng(seed).permutation(cams)[:max(1, int(np.ceil(len(cams)*fraction)))])
+
+
+def weighted_mean(p, w):
+    w = np.broadcast_to(np.asarray(w), p.shape)
+    valid = np.isfinite(p)
+    den = np.where(valid, w, 0).sum(axis=0)
+    num = np.where(valid, p*w, 0).sum(axis=0)
+    return np.divide(num, den, out=np.full(p.shape[1], np.nan), where=den > 0)
+
+
+def point_scores(obs, model):
+    """One point, cameras in canonical order. Distances are Euclidean source range."""
+    p = probs_of(obs).astype(float)
+    count = np.isfinite(p).sum(axis=0)[None, :]
+    g = model.view_gsd(obs["gsd_frontal"], obs["cos_theta"], obs["map_scale"])
+    pi = model.pod(g)
+    plain = replace(model, mode="llr")
+    lam = plain.view_llr(p, None)
+    cens = model.view_llr(p, g)
+    raw = np.nansum(lam, axis=0, keepdims=True)
+    mix = np.nansum(cens, axis=0, keepdims=True)
+    weighted = np.nansum(pi*lam, axis=0, keepdims=True)
+    untempered = replace(model, alpha=np.ones(NUM_CLASSES))
+    dist = obs["range_source"].astype(float)
+    if not np.isfinite(dist).all() or (dist <= 0).any():
+        raise ValueError("Distance baselines require positive Euclidean range_source.")
+    span = np.ptp(dist)
+    # Exact tie convention declared: equal distances -> equal weights; strict range -> no support.
+    dw = np.ones(len(dist)) if span == 0 else 1 - (dist - dist.min())/span
+    maxp = np.max(np.where(np.isfinite(p), p, -np.inf), axis=0)
+    maxp[~np.isfinite(maxp)] = np.nan
+    result = {
+        "mean": weighted_mean(p, np.ones((len(p), 1))),
+        "max": maxp,
+        "angle_range": weighted_mean(p, (obs["cos_theta"] >= np.cos(np.deg2rad(50)))[:, None]),
+        "distance_range": weighted_mean(p, (dist < np.median(dist))[:, None]),
+        "distance_weighted": weighted_mean(p, dw[:, None]),
+        "naive_bayes": untempered.posterior(raw, count)[0],
+        "tempered_bayes": model.posterior(raw, count)[0],
+        "censored_untempered": untempered.posterior(mix, count)[0],
+        "censored": model.posterior(mix, count)[0],
+        "pi_weighted_mean": weighted_mean(p, pi),
+        "pi_weighted_llr": model.posterior(weighted, count)[0]}
+    return result, raw[0], mix[0], count[0], float(np.min(g)), float(np.median(obs["cos_theta"])), weighted[0]
+
+
+def compute(run, d, model, cameras, uncensored_alpha=None, oracle=False, weighted_alpha=None):
+    n = len(d["source_index"])
+    out = {k: np.full((n, NUM_CLASSES), np.nan, float) for k in METHODS}
+    if oracle:
+        out["oracle_best_view"] = np.full((n, NUM_CLASSES), np.nan)
+    out.update(llr=np.zeros((n, NUM_CLASSES)), censored_llr=np.zeros((n, NUM_CLASSES)),
+               pi_llr=np.zeros((n, NUM_CLASSES)),
+               count=np.zeros((n, NUM_CLASSES), dtype=np.uint32),
+               g_min=np.full(n, np.nan), cos_median=np.full(n, np.nan))
+    seen = set()
+    for obs in iter_observations(run, d["source_index"]):
+        obs = obs[np.isin(obs["camera"], cameras)]
+        if not len(obs):
+            continue
+        ids, start, count = np.unique(obs["source_index"], return_index=True, return_counts=True)
+        rows = match_rows(ids, d)
+        if seen.intersection(ids.tolist()):
+            raise ValueError("A source point appears in multiple point chunks.")
+        seen.update(ids.tolist())
+        for row, a, length in zip(rows, start, count):
+            scores, llr, mix, cnt, g, cos, weighted = point_scores(obs[a:a+length], model)
+            for key, value in scores.items():
+                out[key][row] = value
+            if oracle:
+                pp = probs_of(obs[a:a+length])
+                for c in range(NUM_CLASSES):
+                    valid = pp[:, c][np.isfinite(pp[:, c])]
+                    if len(valid) and d["labels"][row, c] >= 0:
+                        out["oracle_best_view"][row, c] = (valid.max() if d["labels"][row, c] else valid.min())
+            if uncensored_alpha is not None:
+                baseline = replace(model, alpha=np.asarray(uncensored_alpha))
+                out["tempered_bayes"][row] = baseline.posterior(llr[None], cnt[None])[0]
+            if weighted_alpha is not None:
+                baseline = replace(model, alpha=np.asarray(weighted_alpha))
+                out["pi_weighted_llr"][row] = baseline.posterior(weighted[None], cnt[None])[0]
+            out["pi_llr"][row] = weighted
+            out["llr"][row], out["censored_llr"][row], out["count"][row] = llr, mix, cnt
+            out["g_min"][row], out["cos_median"][row] = g, cos
+    return out
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--run", required=True)
+    ap.add_argument("--regions", required=True)
+    ap.add_argument("--buffer", type=float, required=True)
+    ap.add_argument("--params", required=True)
+    ap.add_argument("--fraction", type=float, default=1)
+    ap.add_argument("--seed", type=int, default=0)
+    ap.add_argument("--out", type=Path, required=True)
+    ap.add_argument("--oracle", action="store_true", help="diagnostic only: reads labels to select each point/class view")
+    args = ap.parse_args(argv)
+    if args.out.exists() or args.out.with_suffix(".json").exists():
+        raise FileExistsError("Choose a new output (never replace a frozen experiment).")
+    d = regions(args.regions, args.buffer)
+    prov = provenance(args.run, args.regions)
+    params = read_json(args.params)
+    validate_detector(args.run, params)
+    validate_fit_provenance(params, prov)
+    model = FusionModel.from_dict("censored_llr", params)
+    meta = read_json(Path(args.run) / "observations/meta.json")
+    cameras = camera_subset([c["camera"] for c in meta["cameras"]], args.fraction, args.seed)
+    uncensored_alpha = ([params["tempering_diagnostics"][c]["uncensored_alpha"] for c in DAMAGE_CLASSES]
+                        if "tempering_diagnostics" in params else None)
+    weighted_alpha = ([params["tempering_diagnostics"][c]["weighted_alpha"] for c in DAMAGE_CLASSES]
+                      if "tempering_diagnostics" in params else None)
+    out = compute(args.run, d, model, cameras, uncensored_alpha, args.oracle, weighted_alpha)
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    with args.out.open("wb") as f:
+        np.savez_compressed(f, source_index=d["source_index"], classes=np.array(DAMAGE_CLASSES), **out)
+    write_json(args.out.with_suffix(".json"), {
+        "provenance": prov, "params_sha256": sha256_file(args.params),
+        "score_sha256": sha256_file(args.out), "parameters": params,
+        "camera_subset": cameras, "fraction": args.fraction, "seed": args.seed,
+        "buffer": args.buffer, "methods": list(METHODS) + (["oracle_best_view"] if args.oracle else []),
+        "oracle": args.oracle,
+        "note": "Unsigned-normal geometric baselines. Only optional oracle_best_view reads labels; it is not deployable."})
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/damage3d/fusion_params.py b/damage3d/fusion_params.py
new file mode 100644
index 0000000..449c929
--- /dev/null
+++ b/damage3d/fusion_params.py
@@ -0,0 +1,82 @@
+"""Write the ``--fusion-params`` JSON of the llr fusions from a scripts/27 calibration.
+
+The Platt-calibrated probabilities refer to the prevalence of the calibration
+set: rho_c = n_positive_pixels / (n_positive_pixels + n_negative_pixels), read
+from ``diagnostics`` of ``probability_calibration.json``. Individually calibrated
+ensembles are deliberately refused: their mean is not necessarily calibrated.
+
+    python -m damage3d.fusion_params --calibration outputs/runs/<run>/eval_curves/probability_calibration.json \\
+        --out fusion_params_llr.json
+    python -m damage3d.fusion_params --calibration calibration.json \\
+        --pod pod_fit.json --out fusion_params_censored.json
+
+``--pod``: JSON {class: {"g50": g, "beta": b}} with pi_c(g) = sigmoid(-(log g - log g50) / beta)
+(detectability fit, g in source units per MAP pixel); without it the file serves
+``--fusion llr`` only. ``--tempering``: JSON {class: alpha_c}, alpha_c in (0, 1]
+(default 1 = untempered naive Bayes).
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+from .classes import DAMAGE_CLASSES
+
+
+def calibration_priors(path: Path) -> dict[str, float]:
+    d = json.loads(Path(path).read_text(encoding="utf-8"))
+    diag = d.get("diagnostics", {})
+    out = {}
+    for c in DAMAGE_CLASSES:
+        if c not in diag or "n_positive_pixels" not in diag[c]:
+            raise RuntimeError(f"{path}: no pixel counts for '{c}' in diagnostics (scripts/27 JSON expected).")
+        pos, neg = int(diag[c]["n_positive_pixels"]), int(diag[c]["n_negative_pixels"])
+        if pos <= 0 or neg <= 0:
+            raise ValueError(f"{c}: calibration must contain positive and negative pixels.")
+        out[c] = pos / (pos + neg)
+    return out
+
+
+def build(rho: dict[str, float], pod: dict | None, tempering: dict | None, gsd: str, source: str) -> dict:
+    classes = {}
+    for c in DAMAGE_CLASSES:
+        entry = {"rho": rho[c], "alpha": float((tempering or {}).get(c, 1.0))}
+        if pod is not None and c in pod:
+            entry.update(g50=float(pod[c]["g50"]), beta=float(pod[c]["beta"]))
+        classes[c] = entry
+    return {"source": source, "gsd": gsd, "gsd_units": "source_units_per_map_px",
+            "p_clip": 1e-4, "min_cos": 0.0872, "classes": classes}
+
+
+def main(argv=None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    src = ap.add_mutually_exclusive_group(required=True)
+    src.add_argument("--calibration", type=Path, help="scripts/27 probability_calibration.json")
+    src.add_argument("--ensemble", type=Path, help="legacy argument; explicitly rejected for likelihood inference")
+    ap.add_argument("--pod", type=Path, help="JSON {class: {g50, beta}} for censored_llr")
+    ap.add_argument("--tempering", type=Path, help="JSON {class: alpha_c}, alpha_c in (0, 1]")
+    ap.add_argument("--gsd", choices=("effective", "frontal"), default="effective")
+    ap.add_argument("--out", type=Path, required=True)
+    args = ap.parse_args(argv)
+    if args.calibration is not None:
+        priors, source = calibration_priors(args.calibration), str(args.calibration)
+    else:
+        raise ValueError("An ensemble of individually calibrated scores is not necessarily calibrated. "
+                         "Use a single model for the likelihood experiment.")
+    pod = json.loads(args.pod.read_text(encoding="utf-8")) if args.pod else None
+    tempering = json.loads(args.tempering.read_text(encoding="utf-8")) if args.tempering else None
+    data = build(priors, pod, tempering, args.gsd, source)
+    from .run_state import sha256_file
+    data["calibration_sha256"] = sha256_file(args.calibration)
+    from .detectability import FusionModel  # validate before writing
+    FusionModel.from_dict("censored_llr" if pod else "llr", data)
+    from .experiment_data import write_json
+    write_json(args.out, data)
+    print(json.dumps({c: round(v, 6) for c, v in priors.items()}))
+    return 0
+
+
+if __name__ == "__main__":  # pragma: no cover
+    raise SystemExit(main())
diff --git a/damage3d/observations.py b/damage3d/observations.py
new file mode 100644
index 0000000..7df45aa
--- /dev/null
+++ b/damage3d/observations.py
@@ -0,0 +1,143 @@
+"""Per point-view observation log (``--observation-log``).
+
+One record per VALID observation (point in front, inside the image, radial
+guard passed, not occluded, provider pixel valid), i.e. exactly the views added
+to the accumulator. It lets every fusion rule (mean, max, GSD culling, cos/g
+weighting, llr, censored llr) and every detectability estimate be recomputed
+offline without projecting again.
+
+Record (``OBS_DTYPE``, 54 B; probabilities stored exactly as accumulated, float32):
+    source_index  index in the source PLY
+    camera        order of the camera in ``selected_cameras.csv``
+    u, v          full-image pixel coordinates (Metashape corner convention)
+    depth         camera Z (chunk units)
+    range_source  Euclidean camera-to-point distance, SOURCE units (not camera Z)
+    gsd_frontal   depth * s / f, SOURCE units per image pixel (s = chunk->source scale)
+    cos_theta     |cos| between source normal and viewing ray (NaN without normals)
+    map_scale     sigma_v = W / W_m times explicitly declared additional inference_scale
+                  (g_iv = gsd_frontal * map_scale / sqrt(cos_theta), SOURCE units per map px)
+    p_<class>     probability sampled by the provider (NaN = invalid channel)
+
+Files: ``<run>/observations/chunk_XXXXXX_batch_YYYYYY.npy``, one per (point chunk,
+camera batch), written atomically BEFORE the accumulator commit of that chunk:
+a batch replayed after an interruption rewrites the same file, so records are
+never duplicated. ``observations/meta.json`` stores the camera table and units.
+
+Size: ~54 B x (points x mean valid views). Restrict it with
+``--observation-subset`` (``.npy`` of source indices, e.g. ``roi_points_index.npy``
+written by ``damage3d.roi_views``).
+"""
+
+from __future__ import annotations
+
+import os
+import json
+from itertools import groupby
+from pathlib import Path
+
+import numpy as np
+
+from .classes import DAMAGE_CLASSES
+from .run_state import sha256_file, write_json_atomic
+
+OBS_DTYPE = np.dtype([("source_index", "<u4"), ("camera", "<u2"), ("u", "<f4"), ("v", "<f4"),
+                      ("depth", "<f4"), ("gsd_frontal", "<f4"), ("cos_theta", "<f4"),
+                      ("map_scale", "<f4"), ("range_source", "<f4")]
+                     + [(f"p_{c}", "<f4") for c in DAMAGE_CLASSES])
+
+
+def cos_incidence(xyz_src: np.ndarray, normals_src: np.ndarray, center_src: np.ndarray) -> np.ndarray:
+    """|cos| between the (unoriented) normal and the ray point -> camera centre."""
+    ray = np.asarray(center_src, np.float64)[None, :] - np.asarray(xyz_src, np.float64)
+    n = np.asarray(normals_src, np.float64)
+    den = np.linalg.norm(ray, axis=1) * np.linalg.norm(n, axis=1)
+    with np.errstate(invalid="ignore", divide="ignore"):
+        return np.abs(np.einsum("ij,ij->i", ray, n)) / den
+
+
+def make_records(source_index, camera: int, u, v, depth, gsd_frontal, cos_theta, map_scale: float,
+                 probs, range_source=None) -> np.ndarray:
+    rec = np.empty(len(source_index), dtype=OBS_DTYPE)
+    rec["source_index"] = source_index
+    rec["camera"] = camera
+    rec["u"], rec["v"], rec["depth"], rec["gsd_frontal"] = u, v, depth, gsd_frontal
+    rec["cos_theta"] = np.nan if cos_theta is None else cos_theta
+    rec["map_scale"] = map_scale
+    rec["range_source"] = np.nan if range_source is None else range_source
+    for c, name in enumerate(DAMAGE_CLASSES):
+        rec[f"p_{name}"] = probs[:, c]
+    return rec
+
+
+class ObservationLog:
+    def __init__(self, run_path: Path, subset: np.ndarray | None = None):
+        self.dir = Path(run_path) / "observations"
+        self.subset = None if subset is None else np.unique(np.asarray(subset, dtype=np.int64))
+
+    def path(self, chunk: int, batch: int) -> Path:
+        return self.dir / f"chunk_{chunk:06d}_batch_{batch:06d}.npy"
+
+    def seal(self, verify_only=False):
+        """Freeze/check shard inventory after all camera batches are committed.
+
+        Culling and empty ROI intersections legitimately produce no shard. An inventory
+        distinguishes that case from deletion/corruption after the run completed.
+        """
+        inventory = {p.name: sha256_file(p) for p in sorted(self.dir.glob("chunk_*_batch_*.npy"))}
+        path = self.dir / "inventory.json"
+        if path.exists():
+            if json.loads(path.read_text(encoding="utf-8")) != inventory:
+                raise ValueError("Observation inventory changed: missing, extra or corrupted shard.")
+        elif verify_only:
+            raise ValueError("Unsealed observation log: complete/resume projection first.")
+        else:
+            write_json_atomic(path, inventory)
+        return inventory
+
+    def keep_mask(self, source_index: np.ndarray) -> np.ndarray | None:
+        """Points of the chunk that are logged (None = all)."""
+        if self.subset is None:
+            return None
+        return np.isin(source_index, self.subset)
+
+    def write(self, chunk: int, batch: int, records: list[np.ndarray]) -> None:
+        self.dir.mkdir(parents=True, exist_ok=True)
+        data = np.concatenate(records) if records else np.zeros(0, dtype=OBS_DTYPE)
+        path = self.path(chunk, batch)
+        tmp = path.with_name(path.name + ".tmp")
+        with tmp.open("wb") as f:
+            np.save(f, data)
+            f.flush()
+            os.fsync(f.fileno())
+        os.replace(tmp, path)
+
+
+def load_observations(run_path: Path) -> np.ndarray:
+    """All records of a run, sorted by (source_index, camera)."""
+    data = np.concatenate(list(iter_observations(run_path)))
+    return data[np.lexsort((data["camera"], data["source_index"]))]
+
+
+def iter_observations(run_path: Path, source_ids=None):
+    """Read one point chunk across batches; filter ROI before concatenation."""
+    files = sorted((Path(run_path) / "observations").glob("chunk_*_batch_*.npy"))
+    if not files:
+        raise FileNotFoundError(f"No observation log in {run_path} (run with --observation-log).")
+    for _, batch_files in groupby(files, key=lambda p: p.name.split("_batch_")[0]):
+        parts = []
+        for f in batch_files:
+            a = np.load(f, mmap_mode="r", allow_pickle=False)
+            if a.dtype != OBS_DTYPE:
+                raise ValueError(f"{f}: incompatible observation schema; regenerate this run.")
+            parts.append(a if source_ids is None else a[np.isin(a["source_index"], source_ids)])
+        a = np.concatenate(parts)
+        a = a[np.lexsort((a["camera"], a["source_index"]))]
+        if len(a) > 1 and np.any((a["source_index"][1:] == a["source_index"][:-1]) &
+                                (a["camera"][1:] == a["camera"][:-1])):
+            raise ValueError("Duplicate point-camera observations.")
+        yield a
+
+
+def probs_of(records: np.ndarray) -> np.ndarray:
+    """(N, C) float32 probabilities of the records."""
+    return np.column_stack([records[f"p_{c}"].astype(np.float32) for c in DAMAGE_CLASSES])
