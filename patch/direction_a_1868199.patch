+def test_region_bootstrap_paired_identity_and_axis_counts():
+    y = np.array([0, 1]*10)
+    p = np.linspace(.01, .99, 20)
+    out = paired_bootstrap(y, p, p, np.ones(20), np.repeat([0, 1, 2, 3], 5), repeats=50)
